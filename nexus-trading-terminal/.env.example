# =============================================================================
# NEXUS Trading Intelligence - environment configuration
#
#   cp .env.example .env        (npm run setup does this for you)
#
# Every value is optional. With no keys at all the app runs in DEMO MODE:
# deterministic simulated prices, news and calendar, all clearly labelled.
# Secrets stay on the server; the browser only ever sees "configured" plus the
# last four characters. NEVER commit .env (it is git-ignored).
# Keys can also be entered in Settings > Data & API keys, which writes them to
# the git-ignored .secrets.env file instead.
# =============================================================================

# --- AI providers -------------------------------------------------------------
# Claude (Anthropic): analyst, critic, explanations, chat, briefings, chart scanner
ANTHROPIC_API_KEY=
# Gemini (Google): independent second analyst and chart scanner
GEMINI_API_KEY=
# Model routing: "fast" for high-volume tasks, "strong" for signal review/critic/research
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_STRONG=claude-opus-5-5
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_STRONG=gemini-3.1-pro-preview
# Retry a refused Claude request on the provider's fallback model (true/false)
CLAUDE_REFUSAL_FALLBACK=true
# Optional per-model prices (USD per million input/output tokens) for cost estimates
# of models without built-in prices, e.g. {"gemini-3.8-flash": [0.3, 2.5]}
AI_PRICING_JSON=

# --- Market data --------------------------------------------------------------
# demo | twelvedata
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=
# Optional JSON map from NEXUS symbols to provider symbols, e.g. {"NAS100": "NDX"}
MARKET_DATA_SYMBOL_MAP=
# Scales candle cache lifetimes (raise to reduce API usage on free plans)
MARKET_DATA_TTL_MULTIPLIER=1.0

# --- News & economic calendar ---------------------------------------------------
# demo | finnhub
NEWS_PROVIDER=demo
NEWS_API_KEY=
# demo | fmp  (Financial Modeling Prep)
ECONOMIC_CALENDAR_PROVIDER=demo
ECONOMIC_CALENDAR_API_KEY=

# --- Broker / execution ---------------------------------------------------------
# paper is the only implemented broker. MT5 / IBKR / Alpaca adapters are
# documented extension points and refuse to send orders.
BROKER=paper
BROKER_API_KEY=
BROKER_API_SECRET=
# Hard server-side gate for real-money execution. Keep false.
# Live orders would additionally need the Settings UI safety switch and an
# implemented live broker adapter. The kill switch always overrides.
LIVE_TRADING_ENABLED=false

# --- Defaults (initial values; editable later in Settings) ------------------------
DEFAULT_MARKET=XAUUSD
DEFAULT_TIMEFRAME=15m
# Fractions of equity: 0.01 = 1 %
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
PAPER_STARTING_BALANCE=100000

# --- Storage ------------------------------------------------------------------------
# Empty = SQLite at ./data/nexus.db (the tested configuration).
# PostgreSQL URLs (postgresql://user:password@host:5432/nexus) are mapped to
# asyncpg/psycopg2 drivers but are untested here; install asyncpg and
# psycopg2-binary yourself before trying.
DATABASE_URL=
# Empty = in-process cache. Example: redis://localhost:6379/0
REDIS_URL=

# --- Server -------------------------------------------------------------------------
# The API has no login (single-user, local). Keep it bound to localhost.
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated browser origins allowed to call the API / open the WebSocket
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
LOG_JSON=true

# --- Limits & background jobs ---------------------------------------------------------
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_BACKTEST_PER_MINUTE=10
RATE_LIMIT_MARKET_PER_MINUTE=600
RATE_LIMIT_DEFAULT_PER_MINUTE=300
# Days to keep resolved records (empty = keep forever)
DATA_RETENTION_DAYS=
BACKGROUND_TASKS=true
BUILD_MEMORY_ON_STARTUP=true
SIGNAL_SCAN_INTERVAL_SECONDS=60
QUOTE_BROADCAST_INTERVAL_SECONDS=2
MAX_UPLOAD_MB=8

# --- Web app (read by Next.js from apps/web/.env.local or the shell) -------------------
# Where the Next.js server proxies /api/* (server-side only, never sent to the browser)
# NEXUS_API_URL=http://127.0.0.1:8000
# Browser WebSocket endpoint for live updates (default ws://<host>:8000/ws)
# NEXT_PUBLIC_WS_URL=
# NEXT_PUBLIC_BRAND_NAME=NEXUS Trading Intelligence
